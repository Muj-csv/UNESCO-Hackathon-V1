# Copy to .env.local and fill in. .env.local is gitignored via `*.local`.
# The same values go in Vercel → Project → Settings → Environment Variables.

# T6 — the AI participant. Read only by api/ai-hop.ts, server-side; it is
# never exposed to the client, which is the entire point of the proxy.
# Without it the endpoint returns 501 and every round falls back to the
# pre-generated rewrites in src/engine/fallbacks.ts, which is a supported
# way to run the game rather than a broken one.
GROQ_API_KEY=

# Optional. Defaults to llama-3.1-8b-instant — small and fast, because the
# room is watching a shared screen and the proxy gives up at six seconds.
GROQ_MODEL=
