{
  /* The serverless functions in /api were not covered by any tsconfig, so
     `npm run typecheck` never looked at them — api/ai-hop.ts (T6),
     api/room.ts and api/_lib (T7) all shipped unchecked. This adds them,
     with the same loose-in-components posture as tsconfig.app.json.

     Deliberately not wired into `npm run build`: that runs on every Vercel
     deploy, and turning a type error into a failed deploy is the team's call
     to make, not a side effect of adding coverage. `npm run typecheck` runs
     it. */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "noEmit": true,

    /* CLAUDE.md: types on contracts, loose elsewhere. */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api"]
}
